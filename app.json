{
  "expo": {
    "name": "Suffice",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "description": "A private, offline expense tracker. No account, no bank connection, no analytics.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121317",
    "ios": {
      "bundleIdentifier": "com.suffice.money",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.suffice.money",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#121317",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121317",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#5B5BF7",
          "defaultChannel": "bills",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Suffice to use Face ID to unlock your data."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
